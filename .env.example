# OpenRouter — LLM gateway used for explanations and fix generation
OPENROUTER_API_KEY=sk-or-v1-...
CODEWATCH_MODEL=openai/gpt-4o-mini

# Exa — live advisory search for dependency CVEs
EXA_API_KEY=...

# GitHub — used to open the fix pull request
GITHUB_TOKEN=ghp_...
GITHUB_REPO=your-org/your-repo

# Email — how the agent reaches the developer who pushed the code.
# For Gmail: enable 2FA, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Always copied on every alert; also the fallback when the commit author's
# address is private (GitHub noreply).
SECURITY_EMAIL=security-team@example.com
DEFAULT_RECIPIENT=
